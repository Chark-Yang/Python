  <default>

    <joint damping="0.1"
           armature="0.1"
           limited="true"/>

    <geom type="mesh"
          contype="1"
          conaffinity="1"
          condim="3"
          friction="1 0.1 0.1"
          margin="0.001"/>

  </default>

  <asset>
