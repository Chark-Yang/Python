<mujoco model="linker_grasping_scene">
  
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" iterations="50">
    <flag constraint="enable"/>
  </option>

  

  <!-- center相机焦点坐标(如果拖拽画面，相机会永远围绕着这个中心点旋转) extent场景尺度/缩放距离（相机会根据这个位置自动后退1米左右，确保把1米范围内的东西框进画面）  -->
  <statistic center="1.2 0.0 0.8" extent="1.0"/>

  <visual>
  <!-- azimuth 方位角，控制相机在水平面上的左右环绕，地球仪经度，默认是0正前方，正数向右绕，负数向左绕 -->
  <!-- elevation (仰角/俯仰角)控制相机的上下倾斜，通常负数，表示向下倾斜 -->
    <global azimuth="140" elevation="-20" offwidth="1280" offheight="720"/>
    <map znear="0.05"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
  </visual>

  <include file="linker_hand_capsule.xml"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.2 0.2 0.2" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.02"/>
    

    <mesh name ="table" file="assets/table/sigmund_table.stl" scale= "1 1 1"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="1" />
    <light name="top_light" pos="0 0 2" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    
